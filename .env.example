# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://arl:arl@localhost:5433/arl

# Free option (default): Groq. Create a free key at console.groq.com (check their current terms).
LLM_PROVIDER=groq
GROQ_API_KEY=
# Model names change. Set this to a tool-calling model your key can access.
LLM_MODEL=openai/gpt-oss-120b
LLM_MAX_RETRIES=6

# Optional paid alternative:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# Cost reporting. 0 = report token counts only. To show a dollar figure, set a reference
# price per million tokens and label it as a reference rate, not what you paid.
PRICE_IN_PER_MTOK=0
PRICE_OUT_PER_MTOK=0
MAX_SPEND_USD=0
